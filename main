<script>

/* =====================================================
PAGE SWITCHER
===================================================== */

function show(page) {

  document.querySelectorAll('.page')
  .forEach(p => {

    p.style.display = 'none';
  });

  document.getElementById(page)
  .style.display = 'block';
}

/* =====================================================
TITLE TOGGLE
===================================================== */

let logoMode = false;

function toggleLogo() {

  const title =
    document.getElementById('logoTitle');

  const logo =
    document.getElementById('logoCircle');

  logoMode = !logoMode;

  if (logoMode) {

    title.style.display = 'none';

    logo.style.display = 'block';

  } else {

    title.style.display = 'block';

    logo.style.display = 'none';
  }
}

/* =====================================================
SYSTEM LOG
===================================================== */

const logs = [

  '"For we walk by faith, not by sight." — 2 Corinthians 5:7',

  '"The light shines in the darkness." — John 1:5',

  '"Be still, and know that I am God." — Psalm 46:10',

  '"I am the way, the truth, and the life." — John 14:6',

  '"The Lord is my shepherd." — Psalm 23:1',

  '"Fear not, for I am with thee." — Isaiah 41:10',

  '"In the beginning was the Word." — John 1:1',

  '"Let there be light." — Genesis 1:3'
];

function addLog() {

  const log =
    document.getElementById('systemLog');

  const div =
    document.createElement('div');

  div.className = 'msg';

  div.innerText =
    '> ' +
    logs[Math.floor(
      Math.random() * logs.length
    )];

  log.appendChild(div);

  log.scrollTop = log.scrollHeight;
}

/* =====================================================
GUEST BOOK
===================================================== */

function addGuest() {

  const input =
    document.getElementById('guestInput');

  if (!input.value) return;

  const log =
    document.getElementById('guestLog');

  const div =
    document.createElement('div');

  div.className = 'msg';

  div.innerText =
    'guest: ' + input.value;

  log.appendChild(div);

  input.value = '';

  log.scrollTop = log.scrollHeight;
}

/* =====================================================
MUSIC SYSTEM
===================================================== */

const audioCtx =
  new(window.AudioContext ||
      window.webkitAudioContext)();

function playFreq(freq, duration = 350) {

  const osc =
    audioCtx.createOscillator();

  const gain =
    audioCtx.createGain();

  osc.connect(gain);

  gain.connect(audioCtx.destination);

  osc.type = 'sine';

  osc.frequency.value = freq;

  gain.gain.setValueAtTime(
    0.08,
    audioCtx.currentTime
  );

  gain.gain.exponentialRampToValueAtTime(
    0.0001,
    audioCtx.currentTime + duration / 1000
  );

  osc.start();

  osc.stop(
    audioCtx.currentTime + duration / 1000
  );
}

/* =====================================================
FULL MELODY
===================================================== */

function playSong() {

  const notes = [

    392.00,
    440.00,
    493.88,
    523.25,

    493.88,
    440.00,
    392.00,
    329.63,

    392.00,
    440.00,
    493.88,
    523.25,

    587.33,
    523.25,
    493.88,
    440.00,

    392.00,
    329.63,
    392.00
  ];

  notes.forEach((note, index) => {

    setTimeout(() => {

      playFreq(note, 400);

    }, index * 420);
  });
}

/* =====================================================
DRAGGABLE LANTERNS
===================================================== */

document.querySelectorAll('.lantern')
.forEach(lantern => {

  let dragging = false;

  let offsetX = 0;

  let offsetY = 0;

  /* DOUBLE CLICK */

  lantern.addEventListener(
    'dblclick',
    () => {

      lantern.classList.toggle('active');
    }
  );

  /* START DRAG */

  lantern.addEventListener(
    'mousedown',
    e => {

      dragging = true;

      offsetX =
        e.clientX -
        lantern.offsetLeft;

      offsetY =
        e.clientY -
        lantern.offsetTop;
    }
  );

  /* MOVE */

  document.addEventListener(
    'mousemove',
    e => {

      if (!dragging) return;

      lantern.style.left =
        (e.clientX - offsetX) + 'px';

      lantern.style.top =
        (e.clientY - offsetY) + 'px';
    }
  );

  /* STOP */

  document.addEventListener(
    'mouseup',
    () => {

      dragging = false;
    }
  );
});

</script>

